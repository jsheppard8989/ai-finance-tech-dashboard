#!/bin/bash
# TEMPLATE ONLY. Not installed. Install target (gitignored):
#   __REPO__/dragonfly/state/live/ops/run_prep.sh
# after Ditka's explicit go and Jared's approval. See docs/dragonfly/ENGINE.md.
#
# Runs the Dragonfly prep job (15:30 CT, prior session): watchlist, bars, measurements -> handoff/<next session>/prep.json + measurements.json. A wake after 18:00 does not run it (the next morning's pre-open then fails loudly on the missing prep, and no READY is written).
#
# Runs from the Dragonfly RUN CLONE (__REPO__ = ~/projects/dragonfly-run), never
# from the pipeline checkout ~/projects/ai-finance-tech-dashboard (its daemon
# autostashes and pulls that tree). The run clone is fast-forwarded to
# origin/main first; a non-ff state aborts the job.
set -euo pipefail

REPO="${DRAGONFLY_REPO:-__REPO__}"
export DRAGONFLY_PRIVATE_DIR="${DRAGONFLY_PRIVATE_DIR:-__HOME__/projects/dragonfly-private}"
export DRAGONFLY_PIPELINE_LOCK="${DRAGONFLY_PIPELINE_LOCK:-__HOME__/projects/ai-finance-tech-dashboard/pipeline/state/auto_pipeline.lock:__HOME__/projects/ai-finance-tech-dashboard/pipeline/auto_pipeline.lock}"
export TZ="America/Chicago"
export PATH="/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin:/usr/local/bin"
stamp() { date '+%FT%T%z'; }

case "$(cd "$REPO" && pwd -P)" in
  */ai-finance-tech-dashboard)
    echo "$(stamp) refusing: $REPO is the pipeline checkout; use the run clone (~/projects/dragonfly-run)"
    exit 2 ;;
esac

# Weekdays only (launchd already schedules Mon-Fri; this guards manual runs).
# NYSE holidays: the job itself decides from dragonfly/market_calendar.py.
if [ "$(date +%u)" -gt 5 ]; then
  echo "$(stamp) weekend; prep not run"
  exit 0
fi

# Wake guard: launchd runs a missed calendar job when the Mac wakes. Refuse
# outside the sane window. Override for a manual run: DRAGONFLY_JOB_ANYTIME=1
# (the load guards in dragonfly/guards.py still refuse daemon windows).
now_hm=$((10#$(date +%H%M)))
if [ "${DRAGONFLY_JOB_ANYTIME:-0}" != "1" ] && { [ "$now_hm" -lt 1525 ] || [ "$now_hm" -gt 1800 ]; }; then
  echo "$(stamp) outside 15:25-18:00 CT; prep not run"
  exit 0
fi

mkdir -p "$REPO/dragonfly/state/live/logs"
cd "$REPO"
if ! git pull --ff-only --quiet origin main; then
  echo "$(stamp) run clone $REPO could not fast-forward to origin/main; prep not run"
  exit 2
fi
exec /usr/bin/python3 -m dragonfly.jobs prep --repo "$DRAGONFLY_PRIVATE_DIR" "$@"
