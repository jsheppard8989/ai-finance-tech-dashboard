# Dragonfly on the shared always-on Linux box. Sourced by run_job.sh. No secrets:
# git pushes use the box's existing gh credential helper.
export TZ=America/Chicago
export DRAGONFLY_HOME="${DRAGONFLY_HOME:-/workspace/dragonfly-box}"
export DRAGONFLY_RUN="${DRAGONFLY_RUN:-$DRAGONFLY_HOME/run}"                    # checkout of ai-finance-tech-dashboard
export DRAGONFLY_PRIVATE_DIR="${DRAGONFLY_PRIVATE_DIR:-$DRAGONFLY_HOME/dragonfly-private}"
export DRAGONFLY_STATE_DIR="${DRAGONFLY_STATE_DIR:-$DRAGONFLY_HOME/state}"      # book.json, caches, engine state, logs
export DRAGONFLY_PYTHON="${DRAGONFLY_PYTHON:-/workspace/dragonfly-p1/venv/bin/python}"  # py3.13 + jsonschema + yfinance
# The Mac site-pipeline daemon windows (05:00-07:59, 12:00-14:59, 22:00-23:59) do not apply here.
export DRAGONFLY_DAEMON_WINDOWS="${DRAGONFLY_DAEMON_WINDOWS:-none}"
# Honour a site-pipeline lock if the pipeline ever runs from the box checkout.
export DRAGONFLY_PIPELINE_ROOT="${DRAGONFLY_PIPELINE_ROOT:-/workspace/ai-finance-tech-dashboard}"
