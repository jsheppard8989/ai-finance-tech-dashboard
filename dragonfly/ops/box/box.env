# Dragonfly on the shared always-on Linux box. Sourced by run_job.sh. No secrets:
# git pushes use the box's existing gh credential helper.
export TZ=America/Chicago
# The box is shared: these are SET here, never inherited from a caller's shell
# (a stale DRAGONFLY_STATE_DIR from another session once pointed a job at a temp
# folder). Override deliberately with the DRAGONFLY_BOX_* names.
export DRAGONFLY_HOME="${DRAGONFLY_BOX_HOME:-/workspace/dragonfly-box}"
export DRAGONFLY_RUN="${DRAGONFLY_BOX_RUN:-$DRAGONFLY_HOME/run}"                     # checkout of ai-finance-tech-dashboard
export DRAGONFLY_PRIVATE_DIR="${DRAGONFLY_BOX_PRIVATE_DIR:-$DRAGONFLY_HOME/dragonfly-private}"
export DRAGONFLY_STATE_DIR="${DRAGONFLY_BOX_STATE_DIR:-$DRAGONFLY_HOME/state}"       # book.json, caches, engine state, logs
export DRAGONFLY_PYTHON="${DRAGONFLY_BOX_PYTHON:-/workspace/dragonfly-p1/venv/bin/python}"  # py3.13 + jsonschema + yfinance
unset DRAGONFLY_BOOK DRAGONFLY_PIPELINE_LOCK DRAGONFLY_ALLOW_DAEMON_WINDOW
# The Mac site-pipeline daemon windows (05:00-07:59, 12:00-14:59, 22:00-23:59) do not apply here.
export DRAGONFLY_DAEMON_WINDOWS="${DRAGONFLY_BOX_DAEMON_WINDOWS:-none}"
# Honour a site-pipeline lock if the pipeline ever runs from the box checkout.
export DRAGONFLY_PIPELINE_ROOT="${DRAGONFLY_BOX_PIPELINE_ROOT:-/workspace/ai-finance-tech-dashboard}"
# Roots: DRAGONFLY_HANDOFF_ROOT / DRAGONFLY_INBOX_ROOT pass through from the caller
# (unset = the live handoff/ and inbox/).
