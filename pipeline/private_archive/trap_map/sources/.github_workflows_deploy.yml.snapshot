name: Deploy to GitHub Pages

on:
  # Runs on pushes targeting the default branch
  push:
    branches: ["main"]
    paths:
      - 'site/**'
      - 'pipeline/data/**'
      - 'commentary/**'
      - 'pipeline/export_commentary.py'
  
  # Allows you to run this workflow manually from the Actions tab
  workflow_dispatch:

# Sets permissions of the GITHUB_TOKEN to allow deployment to GitHub Pages
permissions:
  contents: read
  pages: write
  id-token: write

# Allow only one concurrent deployment, skipping runs queued between the run in-progress and latest queued
concurrency:
  group: "pages"
  cancel-in-progress: true

jobs:
  # Build job
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4
      
      - name: Setup Pages
        uses: actions/configure-pages@v5
      
      # Trap Map guard: fails the deploy on a bad site/data/trap_map.json or a stale trap-map.html.
      - name: Trap Map check
        run: |
          python3 pipeline/trap_map_check.py
          python3 pipeline/build_trap_map.py --check

      - name: Copy static files
        run: |
          mkdir -p ./_site
          cp -r site/* ./_site/
          # Ensure data directory is included
          ls -la ./_site/data/

      # Market Commentary: render the newest commentary/YYYY-MM-DD.md (escaped) into the
      # artifact, so a merged post goes live without waiting for a Mac publish.
      - name: Build Market Commentary
        run: python3 pipeline/export_commentary.py --out ./_site/data/commentary/latest.json --bake ./_site/index.html
      
      - name: Upload artifact
        uses: actions/upload-pages-artifact@v3
        with:
          path: ./_site

  # Deployment job
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@v4