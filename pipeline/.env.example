# Environment Variables for AI Finance Tech Pipeline
# Copy this file to .env and fill in your actual values
# NEVER commit .env to GitHub - it contains sensitive credentials!

# Gmail Configuration (for newsletter ingestion)
GMAIL_USER=jsheppard8989@gmail.com
GMAIL_APP_PASSWORD=your-app-password-here

# Optional: OpenAI API Key (for transcription)
# OPENAI_API_KEY=your-openai-api-key

# Optional: ElevenLabs (for multi-voice debate audio)
# Weekly debate (debate_weekly.py): uses same LLM as analyze_transcript + ElevenLabs below.
#
# ELEVENLABS_API_KEY=your-elevenlabs-api-key
# ELEVENLABS_HOST_VOICE_ID=your-host-voice-id
# ELEVENLABS_A_VOICE_ID=your-debater-a-voice-id
# ELEVENLABS_B_VOICE_ID=your-debater-b-voice-id

# LLM Model Configuration
# moonshot-v1-8k was retired 2026-08-31; default is now kimi-k2.6
# Override any backend's model via these env vars:
DEBATE_LLM_MODEL=kimi-k2.6
# MOONSHOT_MODEL=kimi-k2.6
# OPENAI_DEBATE_MODEL=gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_DEBATE_MODEL=gemini-1.5-flash
# GEMINI_MODEL=gemini-1.5-flash