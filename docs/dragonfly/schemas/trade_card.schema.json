{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scarcity.local/dragonfly/trade_card.schema.json",
  "title": "Dragonfly 7 Trade Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trade_id",
    "version",
    "status",
    "ticker",
    "setup",
    "direction",
    "instrument",
    "catalyst",
    "why_now",
    "entry",
    "stop",
    "targets",
    "time_stop",
    "sizing",
    "invalidation",
    "invalidation_level",
    "evidence",
    "red_team",
    "risk_decision",
    "human_decision",
    "watcher",
    "created_at",
    "frozen_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "trade_id": { "type": "string", "pattern": "^DF-[0-9]{4}-[0-9]{4}$" },
    "version": { "type": "integer", "minimum": 1 },
    "status": {
      "enum": [
        "candidate",
        "blocked",
        "risk_rejected",
        "pending_human",
        "approved",
        "active",
        "closed",
        "invalidated",
        "expired",
        "breached"
      ]
    },
    "ticker": { "type": "string", "minLength": 1 },
    "setup": {
      "enum": [
        "catalyst_breakout",
        "momentum_pullback",
        "failed_breakdown",
        "compression_expansion"
      ]
    },
    "direction": { "const": "long" },
    "instrument": { "enum": ["stock", "call", "put", "debit_spread"] },
    "catalyst": { "$ref": "#/$defs/catalyst" },
    "why_now": { "type": "string", "minLength": 1 },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "price", "max_fill"],
      "properties": {
        "trigger": { "enum": ["buy_stop", "buy_limit", "market_on_close_above"] },
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "max_fill": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "stop": { "type": "number", "exclusiveMinimum": 0 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["price", "fraction"],
        "properties": {
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "fraction": { "const": 1 }
        }
      }
    },
    "time_stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_calendar_days", "entry_session_date", "exit_session_date"],
      "properties": {
        "max_calendar_days": { "const": 7 },
        "entry_session_date": { "type": "string", "format": "date" },
        "exit_session_date": { "type": "string", "format": "date" }
      }
    },
    "sizing": { "$ref": "#/$defs/sizing" },
    "invalidation": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "enum": ["stop_hit", "level_lost", "time_stop", "catalyst_retracted"] },
      "contains": { "const": "stop_hit" }
    },
    "invalidation_level": { "type": "number", "exclusiveMinimum": 0 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["news", "sec", "x", "relative_volume", "options_note", "price_action"],
      "properties": {
        "news": { "type": "array", "items": { "type": "string" } },
        "sec": { "type": "array", "items": { "type": "string" } },
        "x": { "type": "array", "items": { "type": "string" } },
        "relative_volume": { "type": "number", "minimum": 0 },
        "options_note": { "type": "string" },
        "price_action": { "type": "string", "minLength": 1 }
      }
    },
    "red_team": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "hard_blocks", "warnings", "narrative"],
      "properties": {
        "decision": { "enum": ["pass", "block", "pending"] },
        "hard_blocks": { "type": "array", "items": { "type": "string" } },
        "warnings": {
          "type": "array",
          "items": {
            "enum": [
              "crowded_options",
              "sector_lagging",
              "wide_spread_but_legal",
              "contradictory_filing",
              "valuation_extreme",
              "gap_history",
              "event_just_outside_window"
            ]
          }
        },
        "narrative": { "type": "string" }
      }
    },
    "risk_decision": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "reasons", "risk_mode", "entries_allowed"],
          "properties": {
            "decision": { "enum": ["APPROVED", "REJECTED"] },
            "reasons": { "type": "array", "items": { "type": "string" } },
            "risk_mode": { "enum": ["normal", "cautious", "stand_down"] },
            "entries_allowed": { "type": "boolean" }
          }
        }
      ]
    },
    "human_decision": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "at", "note"],
          "properties": {
            "decision": { "enum": ["approve", "reject", "tighten"] },
            "at": { "type": "string", "format": "date-time" },
            "note": { "type": "string" },
            "tightened_units": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "watcher": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "as_of", "note"],
          "properties": {
            "state": { "enum": ["green", "yellow", "red"] },
            "as_of": { "type": "string", "format": "date-time" },
            "note": { "type": "string" }
          }
        }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "frozen_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
    "engine": { "$ref": "#/$defs/engine" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "invalidation": { "type": "array" } },
        "required": ["invalidation"]
      },
      "then": {
        "properties": {
          "invalidation": { "contains": { "const": "time_stop" } }
        }
      }
    }
  ],
  "$defs": {
    "engine": {
      "description": "Written by the pre-open engine (dragonfly/engine). Optional so hand-built and example cards still validate. See docs/dragonfly/ENGINE.md.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine_version",
        "outcome",
        "reasons",
        "session_date",
        "draft_file",
        "draft_sha256",
        "first_seen_at",
        "cutoff",
        "carded_at",
        "book",
        "inputs"
      ],
      "properties": {
        "engine_version": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["sized", "rejected", "late"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "session_date": { "type": "string", "format": "date" },
        "draft_file": { "type": "string", "minLength": 1 },
        "draft_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "first_seen_at": { "type": "string", "format": "date-time" },
        "cutoff": { "type": "string", "format": "date-time" },
        "carded_at": { "type": "string", "format": "date-time" },
        "book": { "enum": ["paper", "live"] },
        "inputs": { "type": "object" }
      }
    },
    "catalyst": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "summary",
        "source_url",
        "source_type",
        "observed_at",
        "earnings_in_window"
      ],
      "properties": {
        "quality": { "enum": ["primary", "secondary", "absent"] },
        "summary": { "type": "string" },
        "source_url": { "type": "string" },
        "source_type": {
          "enum": ["sec", "earnings", "news", "company", "analyst", "x", "none"]
        },
        "observed_at": { "oneOf": [{ "type": "null" }, { "type": "string", "format": "date-time" }] },
        "earnings_in_window": { "type": "boolean" }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equity_at_decision",
        "units",
        "planned_loss",
        "heat_contribution",
        "open_heat_before",
        "book_heat_cap",
        "name_heat_cap",
        "notional",
        "gap_multiplier",
        "expected_reward",
        "expected_r",
        "initial_risk"
      ],
      "properties": {
        "equity_at_decision": { "type": "number", "exclusiveMinimum": 0 },
        "units": { "type": "integer", "minimum": 0 },
        "planned_loss": { "type": "number", "minimum": 0 },
        "heat_contribution": { "type": "number", "minimum": 0 },
        "open_heat_before": { "type": "number", "minimum": 0 },
        "book_heat_cap": { "type": "number", "minimum": 0 },
        "name_heat_cap": { "type": "number", "minimum": 0 },
        "notional": { "type": "number", "minimum": 0 },
        "gap_multiplier": { "enum": [1, 1.5] },
        "expected_reward": { "type": "number" },
        "expected_r": { "oneOf": [{ "type": "null" }, { "type": "number" }] },
        "initial_risk": { "oneOf": [{ "type": "null" }, { "type": "number", "exclusiveMinimum": 0 }] }
      }
    }
  }
}
