<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.scarcity.pipeline.daemon</string>

    <!-- User LaunchAgent: omit UserName (runs as your login). If you install under /Library/LaunchDaemons as root, add UserName + keep HOME below. -->

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/jaredsheppard/projects/ai-finance-tech-dashboard/pipeline/run_if_scheduled.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/jaredsheppard/projects/ai-finance-tech-dashboard/pipeline</string>

    <!-- Poll run_if_scheduled.sh every 45 min (checks morning/midday/evening windows + 90m cooldown). -->
    <key>StartInterval</key>
    <integer>2700</integer>

    <key>StandardOutPath</key>
    <string>/Users/jaredsheppard/projects/ai-finance-tech-dashboard/pipeline/logs/pipeline_schedule.out</string>
    <key>StandardErrorPath</key>
    <string>/Users/jaredsheppard/projects/ai-finance-tech-dashboard/pipeline/logs/pipeline_schedule.err</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/jaredsheppard</string>
        <key>PATH</key>
        <string>/Users/jaredsheppard/anaconda3/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>WORKSPACE_ROOT</key>
        <string>/Users/jaredsheppard/projects/ai-finance-tech-dashboard</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
